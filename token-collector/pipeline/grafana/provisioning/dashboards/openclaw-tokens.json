{
  "id": null,
  "uid": "openclaw-tokens",
  "title": "OpenClaw 토큰/비용 메트릭",
  "description": "위 4개는 OpenClaw 코어 메트릭(토큰 총량/근사 비용/모델 호출 지연), 아래 2개는 tokenattribution 커넥터의 도구별 귀속 메트릭. 도구별 패널의 점(exemplar)을 누르면 trace_id로 Tempo 실행 기록이 열림.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "15s",
  "tags": ["openclaw", "token-cost"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "누적 토큰 총량",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "openclaw_tokens_total{openclaw_token=\"total\"}",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "근사 누적 비용(USD, placeholder 단가)",
      "description": "prometheus/rules.yml의 recording rule을 쓴 값. 단가가 아직 자리표시자임 — attribution.py의 PRICING_PLACEHOLDER와 동일한 값(input $1.00 / output $5.00 per 1M) 사용 중.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "openclaw:cost_usd:total",
          "legendFormat": "approx cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4 },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "토큰 사용량 (input / output)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (openclaw_token) (openclaw_tokens_total{openclaw_token=~\"input|output\"})",
          "legendFormat": "{{openclaw_token}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "model.call 응답시간 p95 (gen_ai.client.operation.duration)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_operation_duration_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "도구별 귀속 토큰 증가량(추정치) — 점을 누르면 Tempo 실행 기록",
      "description": "순차 구간에서 도구에 귀속된 근사 입력 토큰. 점 하나가 도구 호출 한 건(exemplar)이며, 누르면 trace_id로 Tempo가 열린다. 병렬·배치 호출은 토큰을 귀속하지 않으므로 여기 나타나지 않는다.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "increase(openclaw_tool_attribution_tokens_total[5m])",
          "legendFormat": "{{tool_name}}",
          "exemplar": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "구간 유형별 도구 호출 수(5분 증가량)",
      "description": "sequential / parallel / batch / unattributed. 점을 누르면 해당 호출의 실행 기록(Tempo)이 열린다.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "increase(openclaw_tool_attribution_calls_total[5m])",
          "legendFormat": "{{tool_name}} ({{attribution_pattern}})",
          "exemplar": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ]
}
